    // =========================================================
    // 2. محرك الموسيقى المدمج
    // =========================================================
    let audioCtx = null;
    let musicInterval = null;
    let isPlayingMusic = false;

    const MELODIES = {
      piano: {
        tempo: 520,
        type: 'sine',
        notes: [349.23, 440.00, 523.25, 659.25, 523.25, 440.00, 329.63, 392.00, 493.88, 587.33, 493.88, 392.00]
      },
      musicbox: {
        tempo: 430,
        type: 'sine',
        notes: [659.25, 783.99, 987.77, 1046.50, 987.77, 783.99, 587.33, 698.46, 880.00, 987.77, 880.00, 698.46]
      },
      apology: {
        tempo: 650,
        type: 'triangle',
        notes: [293.66, 349.23, 440.00, 587.33, 523.25, 440.00, 349.23, 392.00, 466.16, 587.33, 523.25, 440.00]
      },
      dreamy: {
        tempo: 580,
        type: 'sine',
        notes: [261.63, 329.63, 392.00, 493.88, 523.25, 493.88, 392.00, 329.63, 293.66, 349.23, 440.00, 523.25]
      },
      friendship: {
        tempo: 420,
        type: 'sine',
        notes: [523.25, 659.25, 783.99, 1046.50, 783.99, 659.25, 587.33, 698.46, 880.00, 783.99, 659.25, 523.25]
      }
    };

    function playSingleNote(freq, waveType) {
      if (!audioCtx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContext();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = waveType;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

      gain.gain.setValueAtTime(0.001, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.14, audioCtx.currentTime + 0.06);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 1.1);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + 1.15);
    }

    function startMusic(trackKey) {
      stopMusic();
      if (!trackKey || trackKey === 'none' || !MELODIES[trackKey]) return;

      const track = MELODIES[trackKey];
      let step = 0;
      isPlayingMusic = true;

      playSingleNote(track.notes[0], track.type);
      step++;

      musicInterval = setInterval(() => {
        if (!isPlayingMusic) return;
        playSingleNote(track.notes[step % track.notes.length], track.type);
        step++;
      }, track.tempo);
    }

    function stopMusic() {
      isPlayingMusic = false;
      if (musicInterval) {
        clearInterval(musicInterval);
        musicInterval = null;
      }
    }

    function togglePreviewAudio() {
      const btn = document.getElementById('previewMusicBtn');
      if (isPlayingMusic) {
        stopMusic();
        btn.textContent = "🔊 تجربة";
      } else {
        const track = document.getElementById('msgMusic').value;
        if (track === 'none') {
          showToast("اختر مقطوعة موسيقية أولاً");
          return;
        }
        startMusic(track);
        btn.textContent = "⏹️ إيقاف";
      }
    }

    function toggleViewerAudio() {
      const btn = document.getElementById('viewerMuteBtn');
      if (isPlayingMusic) {
        stopMusic();
        btn.textContent = "🔇 صامت";
      } else {
        startMusic(currentViewerTrack);
        btn.textContent = "🔊 الصوت";
      }
    }

    // =========================================================
    // 3. التنقل بين التبويبات والإشعارات
    // =========================================================
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 3000);
    }

    function switchTab(tabName) {
      stopMusic();
      document.getElementById('previewMusicBtn').textContent = "🔊 تجربة";

      document.querySelectorAll('.tab-section').forEach(s => s.classList.remove('active'));
      document.getElementById('tab-' + tabName).classList.add('active');

      document.querySelectorAll('.nav-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.target === tabName);
      });

      if (tabName === 'my') {
        renderMyRequests();
        refreshMyRequests();
      } else if (tabName === 'admin') {
        checkAdminSession();
      }
    }

    function selectTemplate(tpl, el) {
      selectedTemplate = tpl;
      document.querySelectorAll('.template-option').forEach(opt => opt.classList.remove('selected'));
      el.classList.add('selected');
    }

    // =========================================================
    // 4. إنشاء رسالة وإرسالها لقاعدة البيانات
    // =========================================================
    function previewCurrentForm() {
      const sender = document.getElementById('senderName').value.trim() || "صديقك";
      const receiver = document.getElementById('receiverName').value.trim() || "أغلى إنسان";
      const body = document.getElementById('messageText').value.trim() || "هذه معاينة لشكل رسالتك عند فتحها...";
      const category = document.getElementById('msgCategory').value;
      const music = document.getElementById('msgMusic').value;

      openViewer({
        sender_name: sender,
        receiver_name: receiver,
        message_text: body,
        category: category,
        template: selectedTemplate,
        music_track: music
      }, false);
    }

    async function submitMessage() {
      const sender = document.getElementById('senderName').value.trim();
      const receiver = document.getElementById('receiverName').value.trim();
      const body = document.getElementById('messageText').value.trim();
      const category = document.getElementById('msgCategory').value;
      const music = document.getElementById('msgMusic').value;

      if (!sender || !receiver || !body) {
        showToast("⚠️ من فضلك املأ جميع الحقول أولاً");
        return;
      }

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = "⏳ جاري الإرسال...";

      const payload = {
        sender_name: sender,
        receiver_name: receiver,
        category: category,
        template: selectedTemplate,
        music_track: music,
        message_text: body,
        status: 'pending'
      };

      const { error } = await db.from('messages').insert([payload]);

      btn.disabled = false;
      btn.textContent = "🚀 إرسال للموافقة";

      if (error) {
        console.error(error);
        showToast("❌ حدث خطأ أثناء الإرسال، تأكد من الإنترنت");
        return;
      }

      const myList = JSON.parse(localStorage.getItem('my_risala_requests') || '[]');
      myList.unshift({
        local_id: Date.now(),
        db_id: null,
        ...payload
      });
      localStorage.setItem('my_risala_requests', JSON.stringify(myList));

      document.getElementById('messageText').value = "";
      showToast("✅ تم إرسال رسالتك للمسؤول بنجاح!");
      switchTab('my');
    }

    // =========================================================
    // 5. متابعة الطلبات ومشاركة واتساب (متوافق مع WebView و APK)
    // =========================================================
    function getShareBaseUrl() {
      if (PUBLIC_WEB_URL) return PUBLIC_WEB_URL.replace(/\/$/, "");
      if (window.location.protocol.startsWith("http")) {
        return window.location.origin + window.location.pathname;
      }
      return "https://your-site.github.io/risala";
    }

    async function refreshMyRequests() {
      const myList = JSON.parse(localStorage.getItem('my_risala_requests') || '[]');
      if (myList.length === 0) return;

      let updated = false;
      for (let item of myList) {
        if (item.status !== 'approved') {
          const { data } = await db
            .from('messages')
            .select('id, status')
            .eq('status', 'approved')
            .eq('sender_name', item.sender_name)
            .eq('receiver_name', item.receiver_name)
            .eq('message_text', item.message_text)
            .order('id', { ascending: false })
            .limit(1);

          if (data && data.length > 0) {
            item.status = 'approved';
            item.db_id = data[0].id;
            updated = true;
          }
        }
      }

      if (updated) {
        localStorage.setItem('my_risala_requests', JSON.stringify(myList));
        showToast("🎉 تمت الموافقة على رسالتك! يمكنك مشاركتها الآن");
      }
      renderMyRequests();
    }

    function renderMyRequests() {
      const container = document.getElementById('myRequestsList');
      const myList = JSON.parse(localStorage.getItem('my_risala_requests') || '[]');

      if (myList.length === 0) {
        container.innerHTML = `<p style="text-align:center; color:var(--text-muted); padding:20px 0;">لم تقم بإنشاء أي رسائل بعد.</p>`;
        return;
      }

      container.innerHTML = myList.map((item, idx) => {
        const isApproved = item.status === 'approved' && item.db_id;
        const badge = isApproved
          ? `<span class="badge badge-approved">✅ تمت الموافقة</span>`
          : `<span class="badge badge-pending">⏳ في انتظار إذن المسؤول</span>`;

        const actionBtn = isApproved
          ? `<button class="btn btn-whatsapp btn-sm" onclick="shareOnWhatsApp(${idx})">📲 إرسال عبر واتساب</button>`
          : `<button class="btn btn-secondary btn-sm" onclick="previewLocalItem(${idx})">👁️ معاينة رسالتي</button>`;

        return `
          <div class="req-card">
            <div class="req-header">
              <span>${item.category}</span>
              ${badge}
            </div>
            <div class="req-names">من: ${escapeHtml(item.sender_name)} ➔ إلى: ${escapeHtml(item.receiver_name)}</div>
            <div class="req-msg">${escapeHtml(item.message_text)}</div>
            ${actionBtn}
          </div>
        `;
      }).join('');
    }

    function previewLocalItem(idx) {
      const myList = JSON.parse(localStorage.getItem('my_risala_requests') || '[]');
      if (myList[idx]) openViewer(myList[idx], false);
    }

    function fallbackCopyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(() => {});
      }
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
    }

    async function shareOnWhatsApp(idx) {
      const myList = JSON.parse(localStorage.getItem('my_risala_requests') || '[]');
      const item = myList[idx];
      if (!item || !item.db_id) return;

      const link = `${getShareBaseUrl()}?id=${item.db_id}`;
      currentShareText = `مفاجأة خاصة ليك يا ${item.receiver_name} من ${item.sender_name} 🎁\nافتح الرابط ده عشان تشوف الرسالة:\n${link}`;

      // نسخ تلقائي للحافظة كضمان إضافي
      fallbackCopyText(currentShareText);

      // 1. محاولة فتح قائمة مشاركة الأندرويد الأصلية (تتجنب خطأ ERR_UNKNOWN_URL_SCHEME نهائياً)
      if (navigator.share) {
        try {
          await navigator.share({
            title: 'مفاجأة خاصة',
            text: currentShareText
          });
          return;
        } catch (err) {
          if (err && err.name === 'AbortError') return;
        }
      }

      // 2. في حال كانت المعاينة داخل Acode لا تدعم قائمة المشاركة: إظهار نافذة النسخ ورابط Intent
      document.getElementById('sharePreviewText').textContent = currentShareText;
      document.getElementById('directIntentBtn').href =
        `intent://send?text=${encodeURIComponent(currentShareText)}#Intent;scheme=whatsapp;package=com.whatsapp;end`;
      document.getElementById('shareModalBackdrop').classList.add('active');
      showToast("📋 تم نسخ الرسالة والرابط تلقائياً!");
    }

    function copyShareTextNow() {
      fallbackCopyText(currentShareText);
      showToast("✅ تم النسخ! افتح واتساب واعمل لصق");
    }

    function closeShareModal(e) {
      if (!e || e.target.id === 'shareModalBackdrop') {
        document.getElementById('shareModalBackdrop').classList.remove('active');
      }
    }

    // =========================================================
    // 6. لوحة إدارة المسؤول
    // =========================================================
    async function checkAdminSession() {
      const { data: { session } } = await db.auth.getSession();
      if (session) {
        document.getElementById('adminLoginBox').style.display = 'none';
        document.getElementById('adminDashboardBox').style.display = 'block';
        loadAdminMessages();
      } else {
        document.getElementById('adminLoginBox').style.display = 'block';
        document.getElementById('adminDashboardBox').style.display = 'none';
      }
    }

    async function adminLogin() {
      const email = document.getElementById('adminEmail').value.trim();
      const password = document.getElementById('adminPassword').value;
      if (!email || !password) {
        showToast("⚠️ أدخل الإيميل وكلمة المرور");
        return;
      }

      const btn = document.getElementById('loginBtn');
      btn.disabled = true;
      btn.textContent = "⏳ جاري التحقق...";

      const { error } = await db.auth.signInWithPassword({ email, password });

      btn.disabled = false;
      btn.textContent = "دخول لوحة الإدارة";

      if (error) {
        showToast("❌ بيانات الدخول غير صحيحة");
        return;
      }

      showToast("👑 مرحباً بك أيها المسؤول");
      checkAdminSession();
    }

    async function adminLogout() {
      await db.auth.signOut();
      showToast("تم تسجيل الخروج");
      checkAdminSession();
    }

    function setAdminFilter(filter, el) {
      adminFilter = filter;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      el.classList.add('active');
      renderAdminMessages();
    }

    async function loadAdminMessages() {
      const listEl = document.getElementById('adminMessagesList');
      listEl.innerHTML = `<p style="text-align:center; color:var(--text-muted);">⏳ جاري تحميل الرسائل...</p>`;

      const { data, error } = await db
        .from('messages')
        .select('*')
        .order('id', { ascending: false });

      if (error) {
        listEl.innerHTML = `<p style="color:#fca5a5;">خطأ في جلب البيانات.</p>`;
        return;
      }

      adminCache = data || [];
      renderAdminMessages();
    }

    function renderAdminMessages() {
      const listEl = document.getElementById('adminMessagesList');
      const filtered = adminFilter === 'all'
        ? adminCache
        : adminCache.filter(m => m.status === adminFilter);

      if (filtered.length === 0) {
        listEl.innerHTML = `<p style="text-align:center; color:var(--text-muted); padding:20px 0;">لا توجد رسائل في هذا القسم.</p>`;
        return;
      }

      listEl.innerHTML = filtered.map(msg => {
        let badgeClass = 'badge-pending', badgeText = '⏳ قيد الانتظار';
        if (msg.status === 'approved') { badgeClass = 'badge-approved'; badgeText = '✅ مقبولة'; }
        if (msg.status === 'rejected') { badgeClass = 'badge-rejected'; badgeText = '❌ مرفوضة'; }

        const tplInfo = TEMPLATE_META[msg.template] ? TEMPLATE_META[msg.template].label : msg.template;

        return `
          <div class="req-card">
            <div class="req-header">
              <span>#${msg.id} • ${tplInfo}</span>
              <span class="badge ${badgeClass}">${badgeText}</span>
            </div>
            <div class="req-names">من: ${escapeHtml(msg.sender_name)} ➔ إلى: ${escapeHtml(msg.receiver_name)}</div>
            <div style="font-size:0.78rem; color:var(--text-muted); margin-bottom:6px;">
              النوع: ${escapeHtml(msg.category)} | اللحن: ${escapeHtml(msg.music_track)}
            </div>
            <div class="req-msg">${escapeHtml(msg.message_text)}</div>
            <div class="admin-actions">
              <button class="btn btn-secondary btn-sm" onclick="adminPreview(${msg.id})">👁️ معاينة</button>
              <button class="btn btn-whatsapp btn-sm" onclick="updateMsgStatus(${msg.id}, 'approved')">✅ موافقة</button>
              <button class="btn btn-sm" style="background:#7f1d1d; color:#fff;" onclick="updateMsgStatus(${msg.id}, 'rejected')">❌ رفض</button>
              <button class="btn btn-sm" style="background:#333; color:#fff;" onclick="deleteMsg(${msg.id})">🗑️ حذف</button>
            </div>
          </div>
        `;
      }).join('');
    }

    function adminPreview(id) {
      const msg = adminCache.find(m => m.id === id);
      if (msg) openViewer(msg, false);
    }

    async function updateMsgStatus(id, newStatus) {
      const { error } = await db
        .from('messages')
        .update({ status: newStatus })
        .eq('id', id);

      if (error) {
        showToast("❌ فشل تحديث الحالة");
        return;
      }

      showToast(newStatus === 'approved' ? "✅ تمت الموافقة على الرسالة" : "❌ تم رفض الرسالة");
      loadAdminMessages();
    }

    async function deleteMsg(id) {
      if (!confirm("هل أنت متأكد من حذف هذه الرسالة نهائياً؟")) return;
      const { error } = await db.from('messages').delete().eq('id', id);
      if (!error) {
        showToast("🗑️ تم حذف الرسالة");
        loadAdminMessages();
      }
    }

    // =========================================================
    // 7. شاشة العرض التفاعلية ثلاثية الأبعاد (8 قوالب)
    // =========================================================
    function openViewer(msg, sharedMode) {
      isSharedLinkMode = sharedMode;
      currentViewerTrack = msg.music_track || 'piano';
      currentViewerTemplate = TEMPLATE_META[msg.template] ? msg.template : 'box';

      const meta = TEMPLATE_META[currentViewerTemplate];
      const overlay = document.getElementById('viewerOverlay');
      const scene = document.getElementById('viewerScene');
      scene.classList.remove('open');
      document.getElementById('burstLayer').innerHTML = '';

      overlay.className = 'viewer-overlay active ' + meta.theme;

      const areaMap = {
        box: 'tplBoxArea',
        envelope: 'tplEnvArea',
        neon: 'tplNeonArea',
        ring: 'tplRingArea',
        bottle: 'tplBottleArea',
        rose: 'tplRoseArea',
        book: 'tplBookArea',
        galaxy: 'tplGalaxyArea'
      };

      Object.keys(areaMap).forEach(key => {
        document.getElementById(areaMap[key]).style.display = (key === currentViewerTemplate) ? 'block' : 'none';
      });

      document.getElementById('vBadge').textContent = msg.category || '✨ إهداء خاص ✨';
      document.getElementById('vTitle').textContent = `إلى: ${msg.receiver_name}`;
      document.getElementById('vBody').textContent = msg.message_text;
      document.getElementById('vFooter').textContent = `من: ${msg.sender_name} 💛`;
      document.getElementById('viewerHint').textContent = meta.hint;
      document.getElementById('closeViewerBtn').textContent = sharedMode ? '✨ اصنع رسالتك' : '✖ إغلاق';

      generateViewerParticles();
    }

    function openSurprise() {
      const scene = document.getElementById('viewerScene');
      if (!scene.classList.contains('open')) {
        scene.classList.add('open');
        startMusic(currentViewerTrack);
        triggerCelebrationBurst(currentViewerTemplate);
      }
    }

    function triggerCelebrationBurst(tplKey) {
      const burstLayer = document.getElementById('burstLayer');
      burstLayer.innerHTML = '';
      const emojis = (TEMPLATE_META[tplKey] && TEMPLATE_META[tplKey].burst) || ['✨', '❤️', '💛'];

      for (let i = 0; i < 26; i++) {
        const item = document.createElement('div');
        item.className = 'burst-item';
        item.textContent = emojis[i % emojis.length];

        const angle = (Math.PI * 2 * i) / 26 + (Math.random() * 0.4);
        const distance = 110 + Math.random() * 140;
        const tx = Math.cos(angle) * distance + 'px';
        const ty = (Math.sin(angle) * distance - 40) + 'px';
        const rot = (Math.random() * 360 - 180) + 'deg';

        item.style.setProperty('--tx', tx);
        item.style.setProperty('--ty', ty);
        item.style.setProperty('--rot', rot);
        burstLayer.appendChild(item);
      }
    }

    function closeViewer() {
      stopMusic();
      document.getElementById('viewerOverlay').classList.remove('active');
      if (isSharedLinkMode) {
        window.history.replaceState({}, document.title, window.location.pathname);
        isSharedLinkMode = false;
      }
    }

    function generateViewerParticles() {
      const container = document.getElementById('viewerParticles');
      container.innerHTML = '';
      for (let i = 0; i < 24; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.left = Math.random() * 100 + 'vw';
        p.style.animationDuration = (4 + Math.random() * 5) + 's';
        p.style.animationDelay = (Math.random() * 4) + 's';
        container.appendChild(p);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    // =========================================================
    // 8. فحص الرابط عند الفتح من واتساب
    // =========================================================
    async function checkIncomingSharedMessage() {
      const params = new URLSearchParams(window.location.search);
      const msgId = params.get('id');
      if (!msgId) return;

      const { data, error } = await db
        .from('messages')
        .select('*')
        .eq('id', msgId)
        .eq('status', 'approved')
        .single();

      if (data && !error) {
        openViewer(data, true);
      } else {
        showToast("⚠️ هذه الرسالة غير متاحة أو بانتظار موافقة المسؤول");
      }
    }

    window.addEventListener('DOMContentLoaded', checkIncomingSharedMessage);
  </script>
